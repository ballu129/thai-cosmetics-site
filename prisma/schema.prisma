generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Brand {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  description String?
  logoUrl     String?
  websiteUrl  String?
  isActive    Boolean   @default(true)
  products    Product[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([name])
}

model Product {
  id                String   @id @default(cuid())
  slug              String   @unique
  name              String
  category          String
  price             Decimal  @db.Decimal(12, 2)
  description       String
  healing           Boolean  @default(false)
  activeIngredients String[]
  imageUrl          String?

  brandId String
  brand   Brand  @relation(fields: [brandId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([name])
  @@index([category])
  @@index([brandId])
  @@index([healing])
}

model Order {
  id           String      @id @default(cuid())
  customerName String
  phone        String
  email        String
  country      String
  city         String
  address      String
  totalAmount  Decimal     @db.Decimal(12, 2)
  status       OrderStatus @default(NEW)
  items        OrderItem[]
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([customerName])
  @@index([phone])
  @@index([email])
  @@index([status])
  @@index([createdAt])
}

model OrderItem {
  id          String  @id @default(cuid())
  productSlug String
  productName String
  unitPrice   Decimal @db.Decimal(12, 2)
  quantity    Int
  lineTotal   Decimal @db.Decimal(12, 2)

  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([orderId])
  @@index([productSlug])
}

enum OrderStatus {
  NEW
  CONFIRMED
  PROCESSING
  SHIPPED
  COMPLETED
  CANCELLED
}
